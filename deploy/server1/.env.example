# Public UDP port on server 1 for WireGuard clients.
WG_PUBLIC_PORT=51820

# Public IP or DNS of server 2 where the vk-turn-proxy server listens.
PEER_ADDR=203.0.113.20:56000

# Public bind address for the local vk-turn client container.
LISTEN_ADDR=0.0.0.0:51820

# Exactly one of these should normally be used.
VK_LINK=https://vk.com/call/join/REPLACE_ME
# YANDEX_LINK=https://telemost.yandex.ru/j/REPLACE_ME

# tcp (default) or udp for the TURN transport.
TRANSPORT_MODE=tcp

# Optional overrides.
# TURN_HOST=
# TURN_PORT=
# CONNECTIONS=16
# NO_DTLS=false
