# IMPORTANT: set SERVERURL to the public IP or DNS of server 1,
# because clients connect to server 1 and traffic is proxied to server 2.
SERVERURL=198.51.100.10
SERVERPORT=51820

# Time zone for the WireGuard container.
TZ=Etc/UTC
PUID=1000
PGID=1000

# How many client profiles linuxserver/wireguard should generate.
PEERS=1
PEERDNS=1.1.1.1
INTERNAL_SUBNET=10.13.13.0
ALLOWEDIPS=0.0.0.0/0,::/0

# The vk-turn-proxy server listens on server 2 and forwards to local WireGuard.
LISTEN_ADDR=0.0.0.0:56000
CONNECT_ADDR=127.0.0.1:51820
